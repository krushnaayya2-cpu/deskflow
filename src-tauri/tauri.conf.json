{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskFlow",
  "version": "0.5.0",
  "identifier": "com.deskflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/settings.html",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "DeskFlow Settings",
        "url": "settings.html",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "DeskFlow",
    "shortDescription": "Glass dock, Dynamic Island, desktop organizer and file converter",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
